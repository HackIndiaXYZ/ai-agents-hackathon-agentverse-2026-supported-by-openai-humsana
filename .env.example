# Copy to .env and fill in. Never commit .env.
#
# The boundary this gate calls.
HUMSANA_BASE_URL=https://api.humsana.com

# Issued by POST /v1/keys and shown once. Run: python3 scripts/issue_key.py
HUMSANA_API_KEY=replace_me

# The key the model proposer runs on. Server side only: read from here, sent in an Authorization
# header, and replaced with [the key] before any error text is printed.
OPENAI_API_KEY=replace_me

# Which model the proposer uses. Leave it unset for the default. If the account cannot serve the
# name, the error lists the names that key can actually use, so set it from that list.
OPENAI_MODEL=gpt-4o-mini

# Only needed to point the proposer at an OpenAI-compatible gateway.
# OPENAI_BASE_URL=https://api.openai.com/v1

# The tool call is forced by default, so the answer is a structured call rather than prose to parse.
# Set to 0 for an endpoint that refuses a forced choice. The proposer falls back on its own if it is
# refused, so this is only for turning the fallback off before it happens.
# OPENAI_FORCE_TOOL=1

# Which action class the live demo drives. One of the keys in humsana_gate/classes.py
DEMO_ACTION_CLASS=hiring.advance_candidate
