# Copy to .env and fill in. Never commit .env.
#
# The boundary this gate calls.
HUMSANA_BASE_URL=https://api.humsana.com

# Issued by POST /v1/keys and shown once. Run: python3 scripts/issue_key.py
HUMSANA_API_KEY=replace_me

# The OpenAI key the demo agent runs on. Server side only.
OPENAI_API_KEY=replace_me
OPENAI_MODEL=gpt-4o-mini

# Which action class the live demo drives. One of the keys in humsana_gate/classes.py
DEMO_ACTION_CLASS=hiring.advance_candidate
